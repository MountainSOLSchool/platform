{
    "defaultProject": "enrollment-portal",
    "useDaemonProcess": false,
    "generators": {
        "@nx/angular:application": {
            "style": "css",
            "linter": "eslint",
            "unitTestRunner": "jest",
            "e2eTestRunner": "cypress"
        },
        "@nx/angular:library": {
            "linter": "eslint",
            "unitTestRunner": "jest"
        },
        "@nx/angular:component": {
            "style": "css",
            "type": "component"
        },
        "@nx/react": {
            "application": {
                "babel": true
            },
            "library": {}
        },
        "@nx/next": {
            "application": {
                "style": "css",
                "linter": "eslint"
            }
        },
        "@nx/angular": {
            "application": {
                "linter": "eslint"
            },
            "library": {
                "linter": "eslint"
            },
            "storybook-configuration": {
                "linter": "eslint"
            },
            "directive": {
                "type": "directive"
            },
            "service": {
                "type": "service"
            },
            "guard": {
                "typeSeparator": "."
            },
            "interceptor": {
                "typeSeparator": "."
            },
            "module": {
                "typeSeparator": "."
            },
            "pipe": {
                "typeSeparator": "."
            },
            "resolver": {
                "typeSeparator": "."
            }
        },
        "@schematics/angular:component": {
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    },
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "targetDefaults": {
        "build": [
            {
                "dependsOn": ["^build"],
                "inputs": ["production", "^production"],
                "cache": true
            },
            {
                "filter": {
                    "plugin": "@nx/next/plugin"
                },
                "configurations": {
                    "development": {},
                    "production": {}
                },
                "defaultConfiguration": "production"
            }
        ],
        "@nx/angular:ng-packagr-lite": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/js:tsc": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "test": [
            {
                "filter": {
                    "plugin": "@nx/jest/plugin"
                },
                "configurations": {
                    "ci": {
                        "ci": true,
                        "coverage": true
                    }
                },
                "options": {
                    "passWithNoTests": true
                }
            }
        ],
        "serve": [
            {
                "filter": {
                    "plugin": "@nx/next/plugin"
                },
                "defaultConfiguration": "development"
            }
        ],
        "@angular-devkit/build-angular:browser": {
            "options": {
                "allowedCommonJsDependencies": [
                    "braintree-web",
                    "braintree-web-drop-in"
                ]
            }
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "sharedGlobals": ["{workspaceRoot}/babel.config.json"],
        "production": [
            "default",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/**/*.stories.[jt]s?(x)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/tsconfig.storybook.json",
            "!{projectRoot}/jest.config.[jt]s",
            "!{projectRoot}/eslint.config.mjs",
            "!{projectRoot}/.storybook/**/*",
            "!{projectRoot}/src/test-setup.[jt]s"
        ]
    },
    "parallel": 1,
    "defaultBase": "main",
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "eslint:lint"
            }
        },
        {
            "plugin": "@nx/storybook/plugin",
            "options": {
                "buildStorybookTargetName": "build-storybook",
                "serveStorybookTargetName": "storybook",
                "testStorybookTargetName": "test-storybook",
                "staticStorybookTargetName": "static-storybook"
            }
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            },
            "include": [
                "apps/enrollment-portal/**/*",
                "apps/functions/**/*",
                "apps/student-portal/**/*",
                "libs/angular/account/**/*",
                "libs/angular/admin/class-printouts/**/*",
                "libs/angular/admin/contacts/**/*",
                "libs/angular/admin/discounts/**/*",
                "libs/angular/admin/enrollment-messages/**/*",
                "libs/angular/admin/enrollments/**/*",
                "libs/angular/admin/students/**/*",
                "libs/angular/auth/firebase/**/*",
                "libs/angular/auth/interceptor/**/*",
                "libs/angular/auth/login/**/*",
                "libs/angular/auth/user/**/*",
                "libs/angular/avatar/**/*",
                "libs/angular/braintree-client/**/*",
                "libs/angular/calendar/calendar/**/*",
                "libs/angular/classes/class-calendar/**/*",
                "libs/angular/classes/class-enrollment/**/*",
                "libs/angular/classes/class-list/**/*",
                "libs/angular/classes/class-management/**/*",
                "libs/angular/classes/class-semester-list/**/*",
                "libs/angular/dialog/**/*",
                "libs/angular/firebase/adapter/**/*",
                "libs/angular/firebase/api/**/*",
                "libs/angular/form/validity/**/*",
                "libs/angular/header/**/*",
                "libs/angular/paths/**/*",
                "libs/angular/request/**/*",
                "libs/angular/skeleton/**/*",
                "libs/angular/toast/**/*",
                "libs/firebase/braintree/**/*",
                "libs/firebase/classes/class-enrollment-repository/**/*",
                "libs/firebase/classes/class-repository/**/*",
                "libs/firebase/classes/semester/**/*",
                "libs/firebase/database/**/*",
                "libs/firebase/functions/**/*",
                "libs/firebase/functions-api/**/*",
                "libs/firebase/payments/**/*",
                "libs/firebase/remote-config-api/**/*",
                "libs/firebase/student/reports/**/*",
                "libs/firebase/student/repository/**/*",
                "libs/react/auth/**/*",
                "libs/react/request/**/*",
                "libs/ts/classes/classes-domain/**/*",
                "libs/ts/firebase/adapter/**/*",
                "libs/ts/firebase/api-types/**/*",
                "libs/ts/firebase/firebase-config/**/*",
                "libs/ts/payments/domain/**/*",
                "libs/ts/record/domain/**/*",
                "libs/ts/student/domain/**/*",
                "libs/ts/student/import/**/*",
                "libs/ts/table/domain/**/*",
                "libs/ts/table/html/**/*",
                "libs/ts/transactions/**/*"
            ]
        },
        {
            "plugin": "@nx/jest/plugin",
            "options": {
                "targetName": "test"
            }
        },
        {
            "plugin": "@nx/next/plugin",
            "options": {
                "buildTargetName": "build",
                "devTargetName": "serve",
                "startTargetName": "start",
                "serveStaticTargetName": "serve-static"
            }
        }
    ],
    "neverConnectToCloud": true,
    "analytics": false,
    "affected": {
        "legacy": true
    }
}
