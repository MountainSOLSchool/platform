    "//overrides": {
        "piscina": "@angular-devkit/build-angular 21.2.24 pins piscina 5.2.0 exactly. Remove at Angular 22.",
        "axios": "nx 22.7.12 pins axios 1.18.1 exactly. Remove once nx pins >=1.20.0.",
        "smol-toml": "nx 22.7.12 pins smol-toml 1.6.1 exactly. Remove once nx pins >=1.9.0.",
        "nx > brace-expansion": "nx 22.7.12 (and 23.2.1) pin brace-expansion 5.0.8 exactly. Remove once nx pins >=5.0.12.",
        "@xmldom/xmldom": "speech-rule-engine 4.1.4 (nextra > better-react-mathjax > mathjax-full, docs site only) pins 0.9.10 exactly. Remove once it pins >=0.9.12.",
        "@nx/react > express": "@nx/react 23 lists express ^4.21.2 as an optional peer (module-federation dev server, unused here), which clashes with our express 5 (firebase-functions). Remove once @nx/react allows express 5.",
        "shell-quote": "concurrently (9.2.4 and 10.0.5) pins shell-quote 1.9.0 exactly (GHSA-pqg4-j6r4-53mv, critical). Remove once concurrently pins >=1.11.0.",
        "nextra > zod, nextra-theme-docs > zod": "@angular/cli 22.2.1 pins zod 4.6.5, which gets hoisted, and nextra 4.6.1 fails to prerender every docs page with it (works on 4.3.x). Keep nextra on 4.3.x; remove once nextra works with the hoisted zod (nextra 5)."
    },
    "//dependencies": {
        "marked-katex-extension": "Not imported by our code: ngx-markdown 22 dynamically imports it (optional peer) and webpack (build-angular:browser) resolves that import at build time, so the build fails without it. Remove if ngx-markdown stops importing it or we leave webpack."
    },
