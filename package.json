    "private": true,
    "//overrides": {
        "@xmldom/xmldom": "speech-rule-engine 4.1.4 (nextra > better-react-mathjax > mathjax-full, docs site only) pins 0.9.10 exactly. Remove once it pins >=0.9.12.",
        "@nx/react > express": "@nx/react 23 lists express ^4.21.2 as an optional peer (module-federation dev server, unused here), which clashes with our express 5 (firebase-functions). Remove once @nx/react allows express 5.",
        "nx > undici": "nx 23.3.1 (and 24.0.1) pins undici 7.29.0 exactly (several DoS advisories, fixed in 7.29.1). Remove once nx pins >=7.29.1.",
        "@angular/build > vite": "@angular/build 22.2.4 pins vite 8.3.0 exactly (launch-editor advisories in vite <=8.3.2, dev server only). Remove once @angular/build pins >=8.3.3.",
        "@firebase/firestore > @grpc/grpc-js": "@firebase/firestore (firebase 12 and 13) pins @grpc/grpc-js ~1.9 (GHSA advisories fixed in 1.13.6). Only the Node build uses gRPC; same-major upgrade. Remove once Firestore allows >=1.13.6.",
        "@google-cloud/pubsub > @opentelemetry/core": "@google-cloud/pubsub 5 (via firebase-tools, dev only) wants @opentelemetry/core ^1 (unbounded Baggage allocation, fixed in 2.8.0). pubsub only uses W3CTraceContextPropagator, unchanged in 2.x. Remove once firebase-tools moves to pubsub 6.",
        "katex": "ngx-markdown, nextra, rehype-katex and micromark-extension-math allow katex ^0.16 only (prototype-pollution trust bypass, fixed in 0.18.2). Remove once they allow >=0.18.2.",
        "@storybook/builder-webpack5 > webpack-dev-middleware": "@storybook/builder-webpack5 10.6.3 wants webpack-dev-middleware ^6 (path traversal, fixed in 7.4.5). Storybook dev server only. Remove once Storybook moves to >=7.4.5.",
        "uuid (scoped)": "gaxios 6 (firebase-tools), jest-junit 16, istanbul-lib-processinfo and @storybook/test-runner want uuid 8/9 (buffer bounds check, fixed in 11.1.1). All dev only; they only call v4(). Remove once those parents move to >=11.1.1.",
        "nextra > zod, nextra-theme-docs > zod": "nextra 4.6.1 fails to prerender docs pages with zod >=4.4 (\"expected nonoptional\" on the Layout children schema; still fails on 4.6.7), so keep nextra on 4.3.x. This leaves GHSA-mrhx-c7xc-m3w5 (zod <4.6.6, memory DoS on oversized input) open, which is acceptable: zod only validates our own docs layout props at build time for a static export. Remove once nextra works with zod >=4.6.6 (nextra 5)."
    },
    "//dependencies": {
        "marked-katex-extension": "Not imported by our code: ngx-markdown 22 dynamically imports it (optional peer) and webpack (build-angular:browser) resolves that import at build time, so the build fails without it. Remove if ngx-markdown stops importing it or we leave webpack."
    },
